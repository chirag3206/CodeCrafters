# ─────────────────────────────────────────────────────────────────────────────
#  PeoplePay360 — Environment Configuration Template
#  ─────────────────────────────────────────────────
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your actual values below
#  3. NEVER commit the real .env file to Git
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production & demo)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/peoplepay360

# SQLite fallback (no setup needed, good for quick local testing)
# DATABASE_URL=sqlite:///./peoplepay360.db


# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production


# ── Gmail SMTP (for real payslip emails with PDF attachment) ──────────────────
#
# Step-by-step Gmail App Password setup:
#   1. Enable 2-Step Verification on your Google Account
#      → https://myaccount.google.com/security
#   2. Generate an App Password
#      → https://myaccount.google.com/apppasswords
#      → Select "Mail" and your device → Generate
#   3. Paste the 16-character App Password in SMTP_PASSWORD below
#
# Without these values, the app runs in demo/offline mode:
#   - Emails are simulated and shown only in the In-App Outbox
#   - No real emails are sent

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address (used as the sender)
SMTP_USER=your.email@gmail.com

# Gmail App Password — NOT your regular Gmail password
SMTP_PASSWORD=your-16-char-app-password

# Display address in the "From" field — must match SMTP_USER for Gmail
SMTP_FROM=your.email@gmail.com


# ── App Settings ──────────────────────────────────────────────────────────────
COMPANY_NAME=PeoplePay360 Inc.
